{
  "name": "pokemon-title-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop tracker for Pokémon titles and Ribbon routes.",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "desktop": "pnpm run build && node desktop/serve.cjs --open",
    "desktop:serve": "node desktop/serve.cjs",
    "desktop:exe": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File desktop/build-exe.ps1",
    "lint": "eslint app components/ui/button.tsx components/ui/checkbox.tsx components/ui/input.tsx components/ui/progress.tsx components/ui/select.tsx lib next.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
